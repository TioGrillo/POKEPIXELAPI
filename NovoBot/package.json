{
  "name": "novobot",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && npm run electron\"",
    "build": "tsc -b && vite build && electron ./scripts/build-bytecode.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.pokepixel.bot",
    "productName": "PokePixel Bot",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "public/LUG.png"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "files": [
      "dist/**/*",
      "bootstrap.cjs",
      "main.jsc",
      "preload.cjs",
      "public/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bytenode": "^1.6.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.5.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^9.1.0"
  },
  "main": "bootstrap.cjs"
}
